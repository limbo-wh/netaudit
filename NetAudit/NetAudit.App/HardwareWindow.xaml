<Window x:Class="NetAudit.App.HardwareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Информация о системе — NetAudit" Height="680" Width="620"
        ResizeMode="CanResize" MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#0C1611" Foreground="#D8EADF"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContentPanel" Margin="0,0,8,0"/>
        </ScrollViewer>

        <Button Grid.Row="1" Content="Закрыть" Click="OnClose"
                HorizontalAlignment="Right" Margin="0,12,0,0"
                Background="#23402F" Foreground="#D8EADF"
                BorderBrush="#2C5039" Padding="16,6" FontSize="12" Cursor="Hand"
                ToolTip="Закрыть окно."/>
    </Grid>
</Window>
