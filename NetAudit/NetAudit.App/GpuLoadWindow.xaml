<Window x:Class="NetAudit.App.GpuLoadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetAudit — нагрузка видеокарты"
        Width="960" Height="640" MinWidth="560" MinHeight="400"
        Background="#0C1611" WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Показатели -->
        <UniformGrid Grid.Row="0" Rows="1" Columns="7" Margin="6,6,6,4">
            <Border Style="{StaticResource Card}" Margin="2" Padding="8,4">
                <StackPanel>
                    <TextBlock Text="Кадров в секунду" Style="{StaticResource Lbl}"/>
                    <TextBlock x:Name="FpsVal" Text="—" FontSize="18" FontWeight="SemiBold"
                               Foreground="#4FD98B"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="2" Padding="8,4">
                <StackPanel>
                    <TextBlock Text="Худший процент" Style="{StaticResource Lbl}"
                               ToolTip="Кадры в секунду в самых медленных кадрах. Именно они ощущаются как рывки."/>
                    <TextBlock x:Name="LowVal" Text="—" FontSize="18" FontWeight="SemiBold"
                               Foreground="#D4E8A8"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="2" Padding="8,4">
                <StackPanel>
                    <TextBlock Text="Время кадра" Style="{StaticResource Lbl}"/>
                    <TextBlock x:Name="FrameVal" Text="—" FontSize="18" FontWeight="SemiBold"
                               Foreground="#B6CDBF"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="2" Padding="8,4">
                <StackPanel>
                    <TextBlock Text="Темп. GPU" Style="{StaticResource Lbl}"/>
                    <TextBlock x:Name="TempVal" Text="—" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="2" Padding="8,4">
                <StackPanel>
                    <TextBlock Text="Загрузка GPU" Style="{StaticResource Lbl}"
                               ToolTip="Доля времени, что видеокарта занята работой."/>
                    <TextBlock x:Name="LoadVal" Text="—" FontSize="18" FontWeight="SemiBold"
                               Foreground="#5CD1C0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="2" Padding="8,4">
                <StackPanel>
                    <TextBlock Text="Мощность" Style="{StaticResource Lbl}"
                               ToolTip="Сколько карта потребляет сейчас и сколько ей разрешено предельно."/>
                    <TextBlock x:Name="PowerVal" Text="—" FontSize="18" FontWeight="SemiBold"
                               Foreground="#DFC46A"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="2" Padding="8,4">
                <StackPanel>
                    <TextBlock Text="Прошло" Style="{StaticResource Lbl}"/>
                    <TextBlock x:Name="TimeVal" Text="00:00" FontSize="18" FontWeight="SemiBold"
                               Foreground="#B6CDBF"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Сюда рисует видеокарта -->
        <Border Grid.Row="1" Margin="8,0,8,4" BorderBrush="#23402F" BorderThickness="1">
            <Grid x:Name="RenderHost" Background="#0C1611"/>
        </Border>

        <!-- Управление -->
        <DockPanel Grid.Row="2" Margin="8,0,8,8" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" x:Name="HintText" Style="{StaticResource Lbl}"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Видеокарта считает сцену целиком: поверхность, мех и освещение — на каждый пиксель."/>

            <Button DockPanel.Dock="Right" Content="Закрыть" Click="OnCloseClick"
                    Padding="14,4" Margin="6,0,0,0"/>
            <Button DockPanel.Dock="Right" x:Name="StopBtn" Content="■ Остановить" Click="OnStopClick"
                    Padding="14,4"
                    ToolTip="Прекратить нагрузку. Окно останется открытым."/>
        </DockPanel>
    </Grid>
</Window>
