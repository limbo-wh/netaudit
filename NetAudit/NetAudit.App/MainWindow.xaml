<Window x:Class="NetAudit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="NetAudit" Height="1000" Width="1000"
        Icon="NetAudit.ico"
        Background="#0C1611" Foreground="White"
        Closing="Window_Closing"
        ToolTip="NetAudit — мониторинг задержки и состояния системы в реальном времени">

    <!-- Стили и палитра — в Theme.xaml, подключён через App.xaml -->

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <!-- Верх и низ — оба звёздные: растут вместе с окном,
                 а сплиттер между ними перераспределяет высоту -->
            <RowDefinition x:Name="RowTop"    Height="3*" MinHeight="200"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="RowBottom" Height="*"  MinHeight="90"/>
        </Grid.RowDefinitions>

        <!-- ═════════════════════ Верхняя часть ═════════════════════ -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>                              <!-- 0: заголовок -->
                <RowDefinition x:Name="RowGwGraph" Height="*"/>            <!-- 1: граф шлюза -->
                <RowDefinition x:Name="RowCfGraph" Height="*"/>            <!-- 2: граф Cloudflare -->
                <RowDefinition Height="Auto"/>                              <!-- 3: статистика + Wi-Fi -->
                <RowDefinition x:Name="RowSysGraphs" Height="170"/>        <!-- 4: системные графики -->
                <RowDefinition Height="Auto"/>                              <!-- 5: системная статистика -->
            </Grid.RowDefinitions>

        <!-- ══════════════════ Заголовок ══════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Строка 1: статус + кнопки -->
            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="BatteryLbl" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed"
                               ToolTip="Состояние батареи: уровень заряда и статус зарядки. Обновляется каждую секунду."/>
                    <Button Content="Железо" Click="OnHardware" Margin="0,0,6,0"
                            Background="#23402F" Foreground="#D8EADF" BorderBrush="#2C5039"
                            Padding="10,4" FontSize="11" Cursor="Hand"
                            ToolTip="Открыть подробную информацию об оборудовании: CPU, RAM, GPU, материнская плата, накопители, сетевые адаптеры."/>
                    <Button x:Name="OverlayBtn" Content="◌ Оверлей" Click="OnOverlayToggle"
                            Margin="0,0,6,0"
                            Background="#23402F" Foreground="#5C7A69" BorderBrush="#2C5039"
                            Padding="10,4" FontSize="11" Cursor="Hand"
                            ToolTip="Показать/скрыть игровой оверлей — полупрозрачную панель с метриками поверх всех окон. Клик-сквозный, не мешает играм."/>
                    <Button Content="⚙ Настройки" Click="OnSettings" Margin="0,0,6,0"
                            ToolTip="Открыть настройки: видимость графиков, оверлей, фильтрация лога."/>
                    <Button Content="О программе" Click="OnAbout"
                            ToolTip="Сведения о программе, возможности и поддержка разработки."/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="NetAudit" FontSize="18" FontWeight="Bold" Foreground="#D8EADF"
                               VerticalAlignment="Center"
                               ToolTip="NetAudit — утилита мониторинга сети и системы."/>
                    <TextBlock x:Name="GatewayLabel" Margin="14,0,0,0" FontSize="12"
                               Foreground="#86D97A" VerticalAlignment="Center"
                               ToolTip="IP-адрес вашего роутера. Определяется автоматически при запуске."/>
                    <TextBlock x:Name="StatusLabel" Margin="14,0,0,0" FontSize="12"
                               Foreground="#5C7A69" VerticalAlignment="Center" Text="Инициализация..."
                               ToolTip="Состояние мониторинга: Работает — пинги идут штатно."/>
                    <TextBlock x:Name="UptimeLabel" Margin="14,0,0,0" FontSize="12"
                               Foreground="#5C7A69" VerticalAlignment="Center"
                               ToolTip="Время работы с момента запуска."/>
                    <Border x:Name="GameModeBadge" Visibility="Collapsed" Margin="14,0,0,0"
                            Background="#172C21" BorderBrush="#4FD98B" BorderThickness="1"
                            CornerRadius="3" Padding="7,1" VerticalAlignment="Center"
                            ToolTip="Обнаружено полноэкранное приложение. NetAudit урезал собственную работу: графики не перерисовываются, метрики опрашиваются реже, приоритет процесса понижен. Пинг при этом идёт с прежней частотой.">
                        <TextBlock x:Name="GameModeText" Text="🎮 игровой режим"
                                   Foreground="#4FD98B" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- Строка 2: краткие сведения о железе -->
            <Border Grid.Row="1" Background="#111F18" BorderBrush="#23402F"
                    BorderThickness="1" CornerRadius="4" Padding="10,4"
                    ToolTip="Краткие сведения об оборудовании. Нажмите «Железо» для подробной информации.">
                <TextBlock x:Name="HwSummaryLbl" FontSize="11" Foreground="#5C7A69"
                           Text="Загрузка информации о системе..."
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </Border>

            <!-- Строка 3: предложить ярлык на рабочем столе (скрыт по умолчанию, один раз) -->
            <Border Grid.Row="2" x:Name="ElevationBanner" Visibility="Collapsed"
                    Background="#1A2E22" BorderBrush="#3A6B4A" BorderThickness="0,1,0,0"
                    Padding="10,5" Margin="0,4,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Click="OnElevationDismiss"
                            Background="Transparent" Foreground="#5C7A69" BorderBrush="Transparent"
                            Padding="8,0" FontSize="14" Cursor="Hand"
                            ToolTip="Скрыть — больше не предлагать. Настроить можно позже в окне настроек."/>
                    <Button DockPanel.Dock="Right" Content="Настроить" Click="OnElevationSetup"
                            Background="#2C5039" Foreground="#D8EADF" BorderBrush="#4FD98B"
                            Padding="10,3" FontSize="11" Cursor="Hand" Margin="0,0,8,0"
                            ToolTip="Создаст задачу в Планировщике заданий. Windows спросит подтверждение один раз — дальше NetAudit будет запускаться с правами администратора без запросов."/>
                    <TextBlock Foreground="#B6CDBF" FontSize="11" VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Text="Температуры, счётчик кадров и очистка памяти требуют прав администратора. Настроить один раз, чтобы дальше запускалось с ними автоматически?"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" x:Name="ShortcutBanner" Visibility="Collapsed"
                    Background="#111F18" BorderBrush="#2C5039" BorderThickness="0,1,0,0"
                    Padding="10,5" Margin="0,4,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Click="OnShortcutDismiss"
                            Background="Transparent" Foreground="#5C7A69" BorderBrush="Transparent"
                            Padding="8,0" FontSize="14" Cursor="Hand"
                            ToolTip="Скрыть — больше не предлагать."/>
                    <Button DockPanel.Dock="Right" Content="Создать ярлык" Click="OnShortcutCreate"
                            Background="#23402F" Foreground="#D8EADF" BorderBrush="#2C5039"
                            Padding="10,3" FontSize="11" Cursor="Hand" Margin="0,0,8,0"/>
                    <TextBlock Text="Создать ярлык NetAudit на рабочем столе?" Foreground="#B6CDBF"
                               FontSize="11" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Строка 4: баннер обновления (скрыт по умолчанию) -->
            <Border Grid.Row="3" x:Name="UpdateBanner" Visibility="Collapsed"
                    Background="#1A2410" BorderBrush="#DFC46A" BorderThickness="0,1,0,0"
                    Padding="10,5" Margin="0,4,0,0"
                    ToolTip="Доступна новая версия NetAudit. Скачайте архив и замените файлы в папке с программой.">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Click="OnUpdateDismiss"
                            Background="Transparent" Foreground="#5C7A69" BorderBrush="Transparent"
                            Padding="8,0" FontSize="14" Cursor="Hand"
                            ToolTip="Скрыть уведомление (до следующего запуска)."/>
                    <Button DockPanel.Dock="Right" x:Name="UpdateDownloadBtn" Content="Скачать ↗"
                            Click="OnUpdateDownload"
                            Background="#23402F" Foreground="#DFC46A" BorderBrush="#2C5039"
                            Padding="10,3" FontSize="11" Cursor="Hand" Margin="0,0,8,0"
                            ToolTip="Открыть страницу загрузки в браузере."/>
                    <TextBlock x:Name="UpdateBannerText" Foreground="#DFC46A" FontSize="11"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ══════════════════ График: шлюз ══════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,4" x:Name="GwGraphPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="Шлюз / Роутер" Foreground="#4FD98B" FontSize="12" FontWeight="SemiBold"
                           ToolTip="График задержки до вашего роутера. Норма: до 5 мс для кабеля, до 20 мс для Wi-Fi."/>
                <TextBlock Text="  —  задержка до вашего роутера (локальная сеть)"
                           Foreground="#4A6355" FontSize="11" VerticalAlignment="Center"
                           ToolTip="Если задержка высокая — проблема в домашней сети, а не в интернете."/>
            </StackPanel>
            <Grid Grid.Row="1">
                <!-- Подсказка отключена: перекрывала график ровно там, где работает курсор -->
                <sp:WpfPlot x:Name="PlotGateway" ToolTipService.IsEnabled="False"/>
                <Rectangle x:Name="GwZoomRect" Visibility="Collapsed" IsHitTestVisible="False"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           Fill="#334FD98B" Stroke="#4FD98B" StrokeThickness="1"/>
                <Border x:Name="GwZoomBadge" Visibility="Collapsed" IsHitTestVisible="False"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,10,0"
                        Background="#DD0C1611" BorderBrush="#4FD98B" BorderThickness="1"
                        CornerRadius="3" Padding="6,2">
                    <TextBlock Text="увеличено · двойной клик — сброс"
                               Foreground="#4FD98B" FontSize="10"/>
                </Border>
                <Line x:Name="GwCursorLine" Visibility="Collapsed" IsHitTestVisible="False"
                      Stroke="#704FD98B" StrokeThickness="1" StrokeDashArray="3 3"
                      HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Ellipse x:Name="GwCursorDot" Visibility="Collapsed" IsHitTestVisible="False"
                         Width="7" Height="7" Fill="#4FD98B" Stroke="#0C1611" StrokeThickness="1"
                         HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border x:Name="GwHoverBubble" Visibility="Collapsed" IsHitTestVisible="False"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Background="#DD0C1611" BorderBrush="#2C5039" BorderThickness="1"
                        CornerRadius="4" Padding="7,3">
                    <TextBlock x:Name="GwHoverText" Foreground="#4FD98B" FontSize="11"
                               FontFamily="Cascadia Code, Consolas, monospace"/>
                </Border>
            </Grid>
        </Grid>

        <!-- ══════════════════ График: 1.1.1.1 ══════════════════ -->
        <Grid Grid.Row="2" Margin="0,0,0,4" x:Name="CfGraphPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="1.1.1.1 / Cloudflare" Foreground="#86D97A" FontSize="12" FontWeight="SemiBold"
                           ToolTip="График задержки до DNS-сервера Cloudflare. Показывает качество интернет-соединения. Норма: 5–50 мс."/>
                <TextBlock Text="  —  задержка до DNS Cloudflare (интернет-соединение)"
                           Foreground="#4A6355" FontSize="11" VerticalAlignment="Center"
                           ToolTip="Если шлюз в норме, а 1.1.1.1 даёт высокий пинг — проблема у провайдера."/>
            </StackPanel>
            <Grid Grid.Row="1">
                <sp:WpfPlot x:Name="PlotCloudflare" ToolTipService.IsEnabled="False"/>
                <Rectangle x:Name="CfZoomRect" Visibility="Collapsed" IsHitTestVisible="False"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           Fill="#3386D97A" Stroke="#86D97A" StrokeThickness="1"/>
                <Border x:Name="CfZoomBadge" Visibility="Collapsed" IsHitTestVisible="False"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,10,0"
                        Background="#DD0C1611" BorderBrush="#86D97A" BorderThickness="1"
                        CornerRadius="3" Padding="6,2">
                    <TextBlock Text="увеличено · двойной клик — сброс"
                               Foreground="#86D97A" FontSize="10"/>
                </Border>
                <Line x:Name="CfCursorLine" Visibility="Collapsed" IsHitTestVisible="False"
                      Stroke="#7086D97A" StrokeThickness="1" StrokeDashArray="3 3"
                      HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Ellipse x:Name="CfCursorDot" Visibility="Collapsed" IsHitTestVisible="False"
                         Width="7" Height="7" Fill="#86D97A" Stroke="#0C1611" StrokeThickness="1"
                         HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border x:Name="CfHoverBubble" Visibility="Collapsed" IsHitTestVisible="False"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Background="#DD0C1611" BorderBrush="#2C5039" BorderThickness="1"
                        CornerRadius="4" Padding="7,3">
                    <TextBlock x:Name="CfHoverText" Foreground="#86D97A" FontSize="11"
                               FontFamily="Cascadia Code, Consolas, monospace"/>
                </Border>
            </Grid>
        </Grid>

        <!-- ══════════════════ Статистика пинга + Wi-Fi ══════════════════ -->
        <StackPanel Grid.Row="3" Margin="0,2,0,6">

            <!-- Карточки GW и CF -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Шлюз ── -->
                <Border Grid.Column="0" Background="#111F18" BorderBrush="#23402F"
                        BorderThickness="1" CornerRadius="4" Padding="10,6"
                        ToolTip="Сводная статистика по шлюзу (роутеру) за текущую сессию.">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Строка 0: заголовок + текущий RTT -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,3">
                            <Ellipse Width="8" Height="8" x:Name="DotGateway" Fill="#86D97A"
                                     VerticalAlignment="Center" Margin="0,0,6,0"
                                     ToolTip="Индикатор: зелёный &lt;15 мс, жёлтый 15–40 мс, красный &gt;40 мс или нет ответа."/>
                            <TextBlock Text="Шлюз (роутер)" Foreground="#4FD98B" FontSize="12" FontWeight="SemiBold"
                                       ToolTip="Пинги до вашего роутера. IP определяется автоматически."/>
                            <TextBlock Text="  ·  Текущий:" Style="{StaticResource Lbl}" Margin="8,0,4,0"
                                       ToolTip="Задержка последнего пинга."/>
                            <TextBlock x:Name="ValGateway" Style="{StaticResource Val}"
                                       Foreground="#4FD98B" MinWidth="55" Text="—"
                                       ToolTip="RTT последнего пинга до роутера. Цвет: зелёный &lt;15 мс, жёлтый 15–40 мс, красный &gt;40 мс."/>
                        </StackPanel>

                        <!-- Строка 1: min / avg / max / jitter -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="min:" Style="{StaticResource Lbl}" Margin="0,0,3,0"
                                       ToolTip="Минимальная задержка за сессию."/>
                            <TextBlock x:Name="MinGw" Style="{StaticResource Val}" Foreground="#4FD98B" MinWidth="42" Text="—"
                                       ToolTip="Наименьший RTT с момента запуска."/>
                            <TextBlock Text="avg:" Style="{StaticResource Lbl}" Margin="8,0,3,0"
                                       ToolTip="Средняя задержка за сессию."/>
                            <TextBlock x:Name="AvgGw" Style="{StaticResource Val}" Foreground="#4FD98B" MinWidth="42" Text="—"
                                       ToolTip="Среднее всех успешных пингов."/>
                            <TextBlock Text="max:" Style="{StaticResource Lbl}" Margin="8,0,3,0"
                                       ToolTip="Максимальная задержка — наихудший скачок."/>
                            <TextBlock x:Name="MaxGw" Style="{StaticResource Val}" Foreground="#4FD98B" MinWidth="42" Text="—"
                                       ToolTip="Наибольший RTT. Большой разрыв avg/max — редкие, но сильные скачки."/>
                            <TextBlock Text="jitter:" Style="{StaticResource Lbl}" Margin="8,0,3,0"
                                       ToolTip="Jitter — средний разброс между соседними пингами. Норма: &lt;5 мс."/>
                            <TextBlock x:Name="JitterGw" Style="{StaticResource Val}" Foreground="#E3B44F" MinWidth="42" Text="—"
                                       ToolTip="Нестабильность задержки. &lt;5 мс — хорошо, &gt;15 мс — плохо для VoIP/игр."/>
                        </StackPanel>

                        <!-- Строка 2: доступность + потери -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="Доступн.:" Style="{StaticResource Lbl}" Margin="0,0,3,0"
                                       ToolTip="Availability — процент успешно доставленных пакетов. 100% = ни одной потери."/>
                            <TextBlock x:Name="AvailGw" Style="{StaticResource Val}" MinWidth="52" Text="—"
                                       ToolTip="Зелёный ≥99% (норма), жёлтый 95–99%, красный &lt;95% (серьёзные проблемы)."/>
                            <TextBlock Text="Потери:" Style="{StaticResource Lbl}" Margin="8,0,3,0"
                                       ToolTip="Packet Loss — процент пакетов без ответа. Даже 1% заметен в играх и звонках."/>
                            <TextBlock x:Name="LossGw" Style="{StaticResource Val}" MinWidth="42" Text="0.00%"
                                       ToolTip="Зелёный 0–1%, жёлтый 1–5%, красный &gt;5%."/>
                        </StackPanel>

                        <!-- Строка 3: подряд + пакеты -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal">
                            <TextBlock Text="Подряд:" Style="{StaticResource Lbl}" Margin="0,0,3,0"
                                       ToolTip="Consecutive loss — количество потерь подряд прямо сейчас. Даже 1 уже означает разрыв в этот момент. При ≥3 в лог записывается предупреждение."/>
                            <TextBlock x:Name="ConsecGw" Style="{StaticResource Val}" Foreground="#4A6355" MinWidth="28" Text="—"
                                       ToolTip="Текущая серия потерь. Жёлтый — единичные, красный — длительный разрыв. При восстановлении сбрасывается в 0."/>
                            <TextBlock Text="Пакеты:" Style="{StaticResource Lbl}" Margin="8,0,3,0"
                                       ToolTip="Получено / Отправлено за сессию."/>
                            <TextBlock x:Name="PktsGw" Style="{StaticResource Val}" Foreground="#4A6355" Text="0 / 0"
                                       ToolTip="Левое — успешных ответов, правое — всего отправлено."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Cloudflare ── -->
                <Border Grid.Column="2" Background="#111F18" BorderBrush="#23402F"
                        BorderThickness="1" CornerRadius="4" Padding="10,6"
                        ToolTip="Сводная статистика по Cloudflare 1.1.1.1 за текущую сессию.">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Строка 0 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,3">
                            <Ellipse Width="8" Height="8" x:Name="DotCf" Fill="#86D97A"
                                     VerticalAlignment="Center" Margin="0,0,6,0"
                                     ToolTip="Индикатор: зелёный &lt;30 мс, жёлтый 30–80 мс, красный &gt;80 мс или нет ответа."/>
                            <TextBlock Text="1.1.1.1 (Cloudflare)" Foreground="#86D97A" FontSize="12" FontWeight="SemiBold"
                                       ToolTip="1.1.1.1 — публичный DNS Cloudflare. Маркер качества интернета."/>
                            <TextBlock Text="  ·  Текущий:" Style="{StaticResource Lbl}" Margin="8,0,4,0"
                                       ToolTip="Задержка последнего пинга до 1.1.1.1."/>
                            <TextBlock x:Name="ValCloudflare" Style="{StaticResource Val}"
                                       Foreground="#86D97A" MinWidth="55" Text="—"
                                       ToolTip="RTT последнего пинга. Цвет: зелёный &lt;30 мс, жёлтый 30–80 мс, красный &gt;80 мс."/>
                        </StackPanel>

                        <!-- Строка 1 -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="min:" Style="{StaticResource Lbl}" Margin="0,0,3,0"
                                       ToolTip="Минимальная задержка до Cloudflare за сессию."/>
                            <TextBlock x:Name="MinCf" Style="{StaticResource Val}" Foreground="#86D97A" MinWidth="42" Text="—"/>
                            <TextBlock Text="avg:" Style="{StaticResource Lbl}" Margin="8,0,3,0"
                                       ToolTip="Средняя задержка — типичный интернет-пинг."/>
                            <TextBlock x:Name="AvgCf" Style="{StaticResource Val}" Foreground="#86D97A" MinWidth="42" Text="—"/>
                            <TextBlock Text="max:" Style="{StaticResource Lbl}" Margin="8,0,3,0"
                                       ToolTip="Максимальная задержка — наибольший скачок."/>
                            <TextBlock x:Name="MaxCf" Style="{StaticResource Val}" Foreground="#86D97A" MinWidth="42" Text="—"/>
                            <TextBlock Text="jitter:" Style="{StaticResource Lbl}" Margin="8,0,3,0"
                                       ToolTip="Jitter интернета. &lt;10 мс — хорошо, &gt;30 мс — заметно мешает."/>
                            <TextBlock x:Name="JitterCf" Style="{StaticResource Val}" Foreground="#E3B44F" MinWidth="42" Text="—"/>
                        </StackPanel>

                        <!-- Строка 2 -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="Доступн.:" Style="{StaticResource Lbl}" Margin="0,0,3,0"
                                       ToolTip="Availability до интернета. 100% = все пинги дошли."/>
                            <TextBlock x:Name="AvailCf" Style="{StaticResource Val}" MinWidth="52" Text="—"
                                       ToolTip="Зелёный ≥99%, жёлтый 95–99%, красный &lt;95%."/>
                            <TextBlock Text="Потери:" Style="{StaticResource Lbl}" Margin="8,0,3,0"
                                       ToolTip="Потери до интернета. Если шлюз без потерь, а здесь есть — проблема у провайдера."/>
                            <TextBlock x:Name="LossCf" Style="{StaticResource Val}" MinWidth="42" Text="0.00%"
                                       ToolTip="Зелёный 0–1%, жёлтый 1–5%, красный &gt;5%."/>
                        </StackPanel>

                        <!-- Строка 3 -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal">
                            <TextBlock Text="Подряд:" Style="{StaticResource Lbl}" Margin="0,0,3,0"
                                       ToolTip="Текущая серия потерь до интернета. При ≥3 в лог записывается предупреждение."/>
                            <TextBlock x:Name="ConsecCf" Style="{StaticResource Val}" Foreground="#4A6355" MinWidth="28" Text="—"
                                       ToolTip="Сколько пингов подряд не получили ответ прямо сейчас."/>
                            <TextBlock Text="Пакеты:" Style="{StaticResource Lbl}" Margin="8,0,3,0"
                                       ToolTip="Получено / Отправлено до Cloudflare."/>
                            <TextBlock x:Name="PktsCf" Style="{StaticResource Val}" Foreground="#4A6355" Text="0 / 0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── Wi-Fi / Ethernet info ── -->
            <Border x:Name="WifiPanel" Margin="0,4,0,0"
                    Background="#111F18" BorderBrush="#23402F"
                    BorderThickness="1" CornerRadius="4" Padding="10,5"
                    ToolTip="Информация о текущем сетевом подключении. Обновляется раз в 5 секунд.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="WifiTypeLbl" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               ToolTip="Тип подключения: Wi-Fi (беспроводное) или Ethernet (кабельное)."/>
                    <TextBlock x:Name="WifiSsidLbl" FontSize="12" Foreground="#D8EADF"
                               VerticalAlignment="Center"
                               ToolTip="Имя Wi-Fi сети (SSID), к которой подключён компьютер."/>
                    <TextBlock x:Name="WifiSignalLbl" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               ToolTip="Уровень сигнала Wi-Fi: % (качество в Windows), дБм (мощность сигнала). -50 дБм = отлично, -70 дБм = слабо. Зелёный ≥70%, жёлтый 40–69%, красный &lt;40%."/>
                    <TextBlock x:Name="WifiTechLbl" FontSize="11" Foreground="#5C7A69"
                               VerticalAlignment="Center"
                               ToolTip="Технические параметры: диапазон (2.4/5/6 ГГц), канал, стандарт Wi-Fi (802.11ax = Wi-Fi 6, 802.11ac = Wi-Fi 5), скорость соединения с точкой доступа (link rate — НЕ скорость интернета)."/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ══════════════════ Системные графики ══════════════════ -->
        <Grid Grid.Row="4" Margin="0,0,0,4" x:Name="SysGraphsGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColNet"  Width="*"/>
                <ColumnDefinition x:Name="ColSep1" Width="8"/>
                <ColumnDefinition x:Name="ColCpu"  Width="*"/>
                <ColumnDefinition x:Name="ColSep2" Width="8"/>
                <ColumnDefinition x:Name="ColRam"  Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Сеть: скорость -->
            <Grid Grid.Column="0" x:Name="NetGraphPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock Text="Сеть" Foreground="#5CD1C0" Style="{StaticResource SecHdr}"
                               ToolTip="Скорость сетевых интерфейсов. Только физические адаптеры, без виртуальных (WSL/VPN)."/>
                    <TextBlock x:Name="ValNet" Margin="6,0,0,0" Style="{StaticResource MiniVal}"
                               ToolTip="↓ входящий (RX/Download), ↑ исходящий (TX/Upload) трафик в МБ/с."/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <sp:WpfPlot x:Name="PlotNet" ToolTipService.IsEnabled="False"/>
                    <Rectangle x:Name="NetZoomRect" Visibility="Collapsed" IsHitTestVisible="False"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Fill="#335CD1C0" Stroke="#5CD1C0" StrokeThickness="1"/>
                    <Border x:Name="NetZoomBadge" Visibility="Collapsed" IsHitTestVisible="False"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,6,0"
                            Background="#DD0C1611" BorderBrush="#5CD1C0" BorderThickness="1"
                            CornerRadius="3" Padding="4,1">
                        <TextBlock Text="2× клик — сброс" Foreground="#5CD1C0" FontSize="9"/>
                    </Border>
                    <Line x:Name="NetCursorLine" Visibility="Collapsed" IsHitTestVisible="False"
                          Stroke="#705CD1C0" StrokeThickness="1" StrokeDashArray="3 3"
                          HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Ellipse x:Name="NetCursorDot" Visibility="Collapsed" IsHitTestVisible="False"
                             Width="7" Height="7" Fill="#5CD1C0" Stroke="#0C1611" StrokeThickness="1"
                             HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Border x:Name="NetHoverBubble" Visibility="Collapsed" IsHitTestVisible="False"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="#DD0C1611" BorderBrush="#2C5039" BorderThickness="1"
                            CornerRadius="4" Padding="7,3">
                        <TextBlock x:Name="NetHoverText" Foreground="#5CD1C0" FontSize="10"
                                   FontFamily="Cascadia Code, Consolas, monospace"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- CPU -->
            <Grid Grid.Column="2" x:Name="CpuGraphPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock Text="CPU" Foreground="#E3B44F" Style="{StaticResource SecHdr}"
                               ToolTip="Загрузка процессора (все ядра) через Windows API GetSystemTimes. Обновляется 1 раз/сек."/>
                    <TextBlock x:Name="ValCpu" Margin="6,0,0,0" Style="{StaticResource MiniVal}"
                               ToolTip="Текущая загрузка CPU. &lt;10% в покое — норма. &gt;80% — высокая нагрузка, может влиять на точность пингов."/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <sp:WpfPlot x:Name="PlotCpu" ToolTipService.IsEnabled="False"/>
                    <Rectangle x:Name="CpuZoomRect" Visibility="Collapsed" IsHitTestVisible="False"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Fill="#33E3B44F" Stroke="#E3B44F" StrokeThickness="1"/>
                    <Border x:Name="CpuZoomBadge" Visibility="Collapsed" IsHitTestVisible="False"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,6,0"
                            Background="#DD0C1611" BorderBrush="#E3B44F" BorderThickness="1"
                            CornerRadius="3" Padding="4,1">
                        <TextBlock Text="2× клик — сброс" Foreground="#E3B44F" FontSize="9"/>
                    </Border>
                    <Line x:Name="CpuCursorLine" Visibility="Collapsed" IsHitTestVisible="False"
                          Stroke="#70E3B44F" StrokeThickness="1" StrokeDashArray="3 3"
                          HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Ellipse x:Name="CpuCursorDot" Visibility="Collapsed" IsHitTestVisible="False"
                             Width="7" Height="7" Fill="#E3B44F" Stroke="#0C1611" StrokeThickness="1"
                             HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Border x:Name="CpuHoverBubble" Visibility="Collapsed" IsHitTestVisible="False"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="#DD0C1611" BorderBrush="#2C5039" BorderThickness="1"
                            CornerRadius="4" Padding="7,3">
                        <TextBlock x:Name="CpuHoverText" Foreground="#E3B44F" FontSize="10"
                                   FontFamily="Cascadia Code, Consolas, monospace"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- RAM -->
            <Grid Grid.Column="4" x:Name="RamGraphPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock Text="RAM" Foreground="#D4E8A8" Style="{StaticResource SecHdr}"
                               ToolTip="Использование оперативной памяти через Windows API GlobalMemoryStatusEx."/>
                    <TextBlock x:Name="ValRam" Margin="6,0,0,0" Style="{StaticResource MiniVal}"
                               ToolTip="Занято / Всего ГБ RAM. Если занято &gt;85% — система может начать использовать swap."/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <sp:WpfPlot x:Name="PlotRam" ToolTipService.IsEnabled="False"/>
                    <Rectangle x:Name="RamZoomRect" Visibility="Collapsed" IsHitTestVisible="False"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Fill="#33D4E8A8" Stroke="#D4E8A8" StrokeThickness="1"/>
                    <Border x:Name="RamZoomBadge" Visibility="Collapsed" IsHitTestVisible="False"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,6,0"
                            Background="#DD0C1611" BorderBrush="#D4E8A8" BorderThickness="1"
                            CornerRadius="3" Padding="4,1">
                        <TextBlock Text="2× клик — сброс" Foreground="#D4E8A8" FontSize="9"/>
                    </Border>
                    <Line x:Name="RamCursorLine" Visibility="Collapsed" IsHitTestVisible="False"
                          Stroke="#70D4E8A8" StrokeThickness="1" StrokeDashArray="3 3"
                          HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Ellipse x:Name="RamCursorDot" Visibility="Collapsed" IsHitTestVisible="False"
                             Width="7" Height="7" Fill="#D4E8A8" Stroke="#0C1611" StrokeThickness="1"
                             HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Border x:Name="RamHoverBubble" Visibility="Collapsed" IsHitTestVisible="False"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="#DD0C1611" BorderBrush="#2C5039" BorderThickness="1"
                            CornerRadius="4" Padding="7,3">
                        <TextBlock x:Name="RamHoverText" Foreground="#D4E8A8" FontSize="10"
                                   FontFamily="Cascadia Code, Consolas, monospace"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ══════════════════ Системная статистика ══════════════════ -->
        <Border Grid.Row="5" Background="#111F18" BorderBrush="#23402F"
                BorderThickness="1" CornerRadius="4" Padding="10,5" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="↓ RX:" Style="{StaticResource Lbl}" Margin="0,0,3,0"
                           ToolTip="Входящий сетевой трафик (Download). МБ/с."/>
                <TextBlock x:Name="StatRx" Style="{StaticResource MiniVal}" Foreground="#5CD1C0" MinWidth="60" Text="0.00 МБ/с"/>
                <TextBlock Text="↑ TX:" Style="{StaticResource Lbl}" Margin="16,0,3,0"
                           ToolTip="Исходящий сетевой трафик (Upload). МБ/с."/>
                <TextBlock x:Name="StatTx" Style="{StaticResource MiniVal}" Foreground="#5CD1C0" MinWidth="60" Text="0.00 МБ/с"/>
                <TextBlock Text="CPU:" Style="{StaticResource Lbl}" Margin="16,0,3,0"
                           ToolTip="Загрузка процессора прямо сейчас."/>
                <TextBlock x:Name="StatCpu" Style="{StaticResource MiniVal}" Foreground="#E3B44F" MinWidth="50" Text="0%"/>
                <TextBlock Text="RAM:" Style="{StaticResource Lbl}" Margin="16,0,3,0"
                           ToolTip="Использование оперативной памяти."/>
                <TextBlock x:Name="StatRam" Style="{StaticResource MiniVal}" Foreground="#D4E8A8" MinWidth="90" Text="0 / 0 ГБ"/>
            </StackPanel>
        </Border>

        </Grid>
        <!-- ═════════════════ Конец верхней части ═════════════════ -->

        <!-- Разделитель: тянется мышью, меняет высоту нижнего блока -->
        <GridSplitter Grid.Row="1" Height="7" HorizontalAlignment="Stretch"
                      VerticalAlignment="Center" Background="Transparent"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"
                      Cursor="SizeNS" Margin="0,1,0,3"
                      MouseDoubleClick="OnSplitterReset"
                      ToolTip="Потяните, чтобы изменить высоту блока лога и диспетчера. Двойной клик — вернуть по умолчанию.">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="{TemplateBinding Background}">
                        <Border Height="3" CornerRadius="2" Background="#23402F"
                                VerticalAlignment="Center"/>
                        <Border x:Name="Grip" Height="3" Width="46" CornerRadius="2"
                                Background="#2C5039" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="#4FD98B"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- ══════════════════ Нижние вкладки: Лог / Диспетчер ══════════════════ -->
        <TabControl Grid.Row="2" x:Name="BottomTabs"
                    SelectionChanged="OnBottomTabChanged"
                    Background="#111F18" BorderBrush="#23402F" Padding="0">
            <!-- Вкладка 1: игровой режим и разгон -->
            <TabItem Header="🎮 Игровой режим" x:Name="GameTab"
                     ToolTip="Авто-режим при запуске игры и одноразовый разгон системы перед игрой.">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#111F18">
                    <StackPanel Margin="14,10,14,14" MaxWidth="640" HorizontalAlignment="Left">

                        <TextBlock Text="Авто-режим" Foreground="#4FD98B" Style="{StaticResource SectionTitle}"
                                   ToolTip="Пока на экране игра, NetAudit урезает собственную работу. Определяется по полноэкранному приложению на переднем плане — без вмешательства в процесс игры."/>
                        <TextBlock Foreground="#5C7A69" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="Частота пинга не меняется никогда: ради него приложение и работает."/>

                        <CheckBox x:Name="ChkGameMode" Content="Замечать запуск игры"
                                  Checked="OnGameCheckChanged" Unchecked="OnGameCheckChanged"
                                  ToolTip="Определять полноэкранное приложение на переднем плане и переходить в экономный режим. Никаких перехватов и внедрения в процесс игры — только штатные функции Windows."/>
                        <CheckBox x:Name="ChkGamePriority" Content="Понижать приоритет процесса NetAudit" Margin="16,2,0,0"
                                  Checked="OnGameCheckChanged" Unchecked="OnGameCheckChanged"
                                  ToolTip="Ставит NetAudit ниже обычного приоритета, чтобы процессор в первую очередь доставался игре."/>
                        <CheckBox x:Name="ChkGameSlowMetrics" Content="Реже опрашивать метрики" Margin="16,2,0,0"
                                  Checked="OnGameCheckChanged" Unchecked="OnGameCheckChanged"
                                  ToolTip="Системные метрики раз в 2 секунды вместо секунды, Wi-Fi раз в полминуты."/>
                        <CheckBox x:Name="ChkGameQuietLog" Content="В логе только потери и спайки" Margin="16,2,0,0"
                                  Checked="OnGameCheckChanged" Unchecked="OnGameCheckChanged"
                                  ToolTip="Во время игры обычные строки пинга в лог не пишутся. Потери и аномальные задержки записываются как обычно."/>
                        <CheckBox x:Name="ChkGameLossAlerts" Content="Баллон в трее при серии потерь" Margin="0,8,0,0"
                                  Checked="OnGameCheckChanged" Unchecked="OnGameCheckChanged"
                                  ToolTip="Всплывающее уведомление в трее при 5 потерянных пингах подряд во время игры — чтобы заметить проблему, пока окно свёрнуто."/>

                        <TextBlock Text="Не считать игрой:" Foreground="#5C7A69" FontSize="11" Margin="0,10,0,4"
                                   ToolTip="Полноэкранные плеер, редактор или что-то ещё, что не должно включать авто-режим. Список запоминается между запусками."/>
                        <Button Content="⟳ Обновить список запущенных программ" Click="OnExcludeRefreshProcesses"
                                HorizontalAlignment="Left"
                                Background="#23402F" Foreground="#D8EADF" BorderBrush="#2C5039"
                                Padding="8,2" FontSize="11" Cursor="Hand" Margin="0,0,0,4"
                                ToolTip="Показать текущие запущенные программы с окном. Отметьте, что не считать игрой."/>
                        <Border BorderBrush="#23402F" BorderThickness="1" Height="100">
                            <ListBox x:Name="ExcludeProcessList" Background="#0C1611" BorderThickness="0"
                                     FontSize="11" Foreground="#D8EADF"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding Checked}"
                                                  Foreground="#D8EADF" Margin="2,1"
                                                  Checked="OnExcludeProcessCheckChanged" Unchecked="OnExcludeProcessCheckChanged"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Border Height="1" Background="#23402F" Margin="0,14,0,12"/>

                        <TextBlock Text="Разгон перед игрой" Foreground="#4FD98B" Style="{StaticResource SectionTitle}"
                                   ToolTip="Разовое включение перед сессией: применяет твики системы и закрывает выбранные программы."/>
                        <TextBlock Foreground="#5C7A69" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="Хоткей: Ctrl+Alt+B. Откатывается той же кнопкой, а если прошлый сеанс закрылся аварийно — сам при следующем запуске NetAudit."/>

                        <CheckBox x:Name="ChkBoostPower" Content="План питания «Высокая производительность»"
                                  Checked="OnBoostOptionChanged" Unchecked="OnBoostOptionChanged"
                                  ToolTip="Переключает активную схему электропитания. Прежняя схема возвращается при выключении разгона."/>
                        <CheckBox x:Name="ChkBoostNotify" Content="Отключить уведомления Windows" Margin="0,2,0,0"
                                  Checked="OnBoostOptionChanged" Unchecked="OnBoostOptionChanged"
                                  ToolTip="Всплывающие тосты не отвлекают во время игры. Только для текущего пользователя, прав администратора не требует."/>
                        <CheckBox x:Name="ChkBoostEffects" Content="Отключить визуальные эффекты" Margin="0,2,0,0"
                                  Checked="OnBoostOptionChanged" Unchecked="OnBoostOptionChanged"
                                  ToolTip="Анимации и прозрачность интерфейса Windows — заметная экономия на слабых встроенных видеокартах."/>
                        <CheckBox x:Name="ChkBoostServices" Content="Остановить SysMain и индексацию поиска" Margin="0,2,0,0"
                                  Checked="OnBoostOptionChanged" Unchecked="OnBoostOptionChanged"
                                  ToolTip="Требует прав администратора — Windows спросит подтверждение (UAC) один раз при включении и один раз при выключении разгона."/>
                        <CheckBox x:Name="ChkBoostPriority" Content="Повышать приоритет процесса игры" Margin="0,2,0,0"
                                  Checked="OnBoostOptionChanged" Unchecked="OnBoostOptionChanged"
                                  ToolTip="Как только игра развернётся на весь экран, её процесс получит приоритет AboveNormal. Возвращается обратно при выходе из игры или выключении разгона."/>

                        <TextBlock Text="Закрыть при включении:" Foreground="#5C7A69" FontSize="11" Margin="0,10,0,4"
                                   ToolTip="Список запоминается между запусками NetAudit."/>
                        <Button Content="⟳ Обновить список запущенных программ" Click="OnBoostRefreshProcesses"
                                HorizontalAlignment="Left"
                                Background="#23402F" Foreground="#D8EADF" BorderBrush="#2C5039"
                                Padding="8,2" FontSize="11" Cursor="Hand" Margin="0,0,0,4"
                                ToolTip="Показать текущие запущенные программы с окном. Отметьте, что закрывать при разгоне."/>
                        <Border BorderBrush="#23402F" BorderThickness="1" Height="140">
                            <ListBox x:Name="BoostProcessList" Background="#0C1611" BorderThickness="0"
                                     FontSize="11" Foreground="#D8EADF"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding Checked}"
                                                  Foreground="#D8EADF" Margin="2,1"
                                                  Checked="OnBoostProcessCheckChanged" Unchecked="OnBoostProcessCheckChanged"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Button x:Name="BoostToggleBtn" Content="🚀 Включить разгон" Click="OnBoostToggle"
                                Margin="0,12,0,0" Padding="10,8" FontSize="13" FontWeight="SemiBold"
                                Background="#1F6B3E" Foreground="White" BorderBrush="#4FD98B" Cursor="Hand"
                                ToolTip="Применить выбранные твики и закрыть отмеченные программы. Повторное нажатие — откатить."/>

                        <TextBlock x:Name="BoostStatusText" Foreground="#5C7A69" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Вкладка 2: Диспетчер задач -->
            <TabItem Header="⚙ Диспетчер" x:Name="ProcTab"
                     ToolTip="Топ процессов по загрузке CPU и памяти. Обновляется раз в 2 секунды.">
                <Grid Background="#111F18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель инструментов диспетчера -->
                    <Border Grid.Row="0" Background="#0C1611" BorderBrush="#23402F"
                            BorderThickness="0,0,0,1" Padding="6,4">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="Поиск:" Style="{StaticResource Lbl}"
                                       Margin="0,0,4,0"/>
                            <TextBox DockPanel.Dock="Left" x:Name="ProcSearchBox" Width="140"
                                     FontSize="11" Background="#23402F" Foreground="#D8EADF"
                                     BorderBrush="#2C5039" Padding="4,2"
                                     TextChanged="OnProcSearchChanged"
                                     ToolTip="Фильтр по имени процесса."/>

                            <TextBlock DockPanel.Dock="Left" Text="Сортировка:" Style="{StaticResource Lbl}"
                                       Margin="12,0,4,0"/>
                            <ComboBox DockPanel.Dock="Left" x:Name="ProcSortCombo" Width="120"
                                      FontSize="11" Background="#23402F" Foreground="#D8EADF"
                                      BorderBrush="#2C5039" SelectedIndex="0"
                                      SelectionChanged="OnProcSortChanged"
                                      ToolTip="Порядок строк. Заголовки колонок тоже кликабельны.">
                                <ComboBoxItem Content="CPU ↓"    Tag="cpu"/>
                                <ComboBoxItem Content="Память ↓" Tag="ram"/>
                                <ComboBoxItem Content="Имя ↑"    Tag="name"/>
                            </ComboBox>

                            <CheckBox DockPanel.Dock="Left" x:Name="ProcGroupChk" Content="Группировать"
                                      Foreground="#D8EADF" FontSize="11" VerticalAlignment="Center"
                                      Margin="12,0,0,0"
                                      Checked="OnProcGroupChanged" Unchecked="OnProcGroupChanged"
                                      ToolTip="Сложить процессы с одинаковым именем в одну строку (chrome.exe ×24). Показывает суммарные CPU и память."/>

                            <TextBlock DockPanel.Dock="Left" x:Name="ProcCountLbl"
                                       Style="{StaticResource Lbl}" Margin="12,0,0,0" Text="0 процессов"
                                       ToolTip="Показано строк из общего числа процессов в системе."/>

                            <ComboBox DockPanel.Dock="Right" x:Name="ProcLimitCombo" Width="86"
                                      FontSize="11" Background="#23402F" Foreground="#D8EADF"
                                      BorderBrush="#2C5039" SelectedIndex="1"
                                      SelectionChanged="OnProcLimitChanged"
                                      ToolTip="Сколько строк показывать.">
                                <ComboBoxItem Content="Топ 15"  Tag="15"/>
                                <ComboBoxItem Content="Топ 35"  Tag="35"/>
                                <ComboBoxItem Content="Топ 100" Tag="100"/>
                                <ComboBoxItem Content="Все"     Tag="0"/>
                            </ComboBox>
                        </DockPanel>
                    </Border>

                    <!-- Заголовок таблицы -->
                    <Border Grid.Row="1" BorderBrush="#23402F" BorderThickness="0,0,0,1" Padding="6,4,6,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Процесс" Grid.Column="0" Tag="name" MouseLeftButtonUp="OnProcHeaderClick"
                                       Foreground="#5C7A69" FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                                       ToolTip="Имя исполняемого файла. Нажмите, чтобы сортировать по имени."/>
                            <TextBlock Text="CPU %" Grid.Column="1" Tag="cpu" MouseLeftButtonUp="OnProcHeaderClick"
                                       Foreground="#E3B44F" FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                                       HorizontalAlignment="Right"
                                       ToolTip="Загрузка CPU процессом, делится на число ядер. Нажмите, чтобы сортировать."/>
                            <TextBlock Text="ОЗУ (МБ)" Grid.Column="2" Tag="ram" MouseLeftButtonUp="OnProcHeaderClick"
                                       Foreground="#D4E8A8" FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                                       HorizontalAlignment="Right" Margin="0,0,6,0"
                                       ToolTip="Рабочий набор памяти (Working Set). Нажмите, чтобы сортировать."/>
                        </Grid>
                    </Border>

                    <ListView Grid.Row="2" x:Name="ProcessList"
                              Background="Transparent" BorderThickness="0"
                              FontSize="11" Foreground="#D8EADF"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True"
                              ToolTip="Процессы системы. Обновляется раз в 2 секунды.">
                        <ListView.ContextMenu>
                            <ContextMenu Background="#0C1611" Foreground="#D8EADF">
                                <MenuItem Header="Копировать имя" Click="OnProcCopyName"
                                          ToolTip="Скопировать имя выделенного процесса в буфер обмена."/>
                                <MenuItem Header="Найти этот процесс" Click="OnProcFilterBySelected"
                                          ToolTip="Подставить имя выделенного процесса в поле поиска."/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="6,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#22FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}"
                                               Foreground="#D8EADF"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CpuText}"
                                               HorizontalAlignment="Right"
                                               Foreground="{Binding CpuColor}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding RamText}"
                                               HorizontalAlignment="Right" Margin="0,0,6,0"
                                               Foreground="#D4E8A8"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- Вкладка 3: тесты и сервис -->
            <TabItem Header="🧪 Тесты и сервис" x:Name="TestTab"
                     ToolTip="Разовые проверки: скорость и качество канала, DNS, маршрут, MTU, железо. И сброс сети без перезагрузки Windows.">
                <Grid Background="#111F18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="TestBtnCol" Width="232" MinWidth="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="200"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── Левая колонка: кнопки ── -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                  Background="#0C1611" Padding="8,4,8,8">
                        <StackPanel>

                            <TextBlock Text="СЕТЬ" Style="{StaticResource TestGroup}"/>

                            <Button Content="▶  Полная диагностика сети" Click="OnTestFullNetwork"
                                    Style="{StaticResource TestBtnPrimary}"
                                    ToolTip="Прогоняет подряд: скорость и bufferbloat, DNS, трассировку и MTU. Занимает около двух минут."/>
                            <Button Content="Скорость и bufferbloat" Click="OnTestSpeed"
                                    Style="{StaticResource TestBtn}"
                                    ToolTip="Приём и отдача плюс, что важнее для игр, прирост задержки когда канал занят. Около 30 секунд, на это время канал загружен полностью."/>
                            <Button Content="DNS-серверы" Click="OnTestDns"
                                    Style="{StaticResource TestBtn}"
                                    ToolTip="Сравнивает ваш DNS с публичными по скорости ответа. Заодно проверяет, не подменяет ли провайдер ответы."/>
                            <Button Content="Трассировка маршрута" Click="OnTestTrace"
                                    Style="{StaticResource TestBtn}"
                                    ToolTip="Показывает путь до цели и задержку на каждом узле — видно, на каком участке она набирается."/>
                            <Button Content="Проверка MTU" Click="OnTestMtu"
                                    Style="{StaticResource TestBtn}"
                                    ToolTip="Ищет наибольший пакет, проходящий без дробления. Заниженный MTU даёт вылеты из игр при нормальном пинге."/>

                            <TextBlock Text="ЖЕЛЕЗО" Style="{StaticResource TestGroup}"/>

                            <Button Content="Процессор, память, диск" Click="OnTestHardware"
                                    Style="{StaticResource TestBtn}"
                                    ToolTip="Скорость всех трёх плюс проверка на троттлинг под длительной нагрузкой. Около минуты, система загружена полностью."/>
                            <Button Content="Только процессор" Click="OnTestCpu"
                                    Style="{StaticResource TestBtn}"
                                    ToolTip="Одно ядро, все ядра и падение производительности за время нагрузки."/>

                            <TextBlock Text="ВИДЕОКАРТА" Style="{StaticResource TestGroup}"/>

                            <Button Content="▶  Полная диагностика" Click="OnGpuFullDiagnostic"
                                    Style="{StaticResource TestBtnPrimary}"
                                    ToolTip="Паспорт, здоровье, скорость памяти и вычислений, проверка видеопамяти шаблонами и выводы — на что карта способна в играх и в нейросетях. Занимает около минуты, карта нагружается кратковременно."/>
                            <Button Content="Паспорт и здоровье" Click="OnGpuPassport"
                                    Style="{StaticResource TestBtn}"
                                    ToolTip="Модель, поколение, прошивка, драйвер, состояние шины PCI Express и пределы мощности. Плюс жалобы видеодрайвера в журнале Windows. Мгновенно, без нагрузки."/>
                            <Button Content="Проверка видеопамяти" Click="OnGpuMemoryTest"
                                    Style="{StaticResource TestBtn}"
                                    ToolTip="Записывает во всю свободную видеопамять проверочные шаблоны и сверяет обратно — как MemTest, но для видеокарты. Главная проверка для карты, купленной с рук: деградация памяти даёт артефакты и вылеты из игр."/>
                            <Button Content="👁  Нагрузка с картинкой" Click="OnGpuVisualLoad"
                                    Style="{StaticResource TestBtn}"
                                    ToolTip="Открывает окно, где видеокарта рисует тяжёлую сцену — вращающийся мохнатый бублик, как в FurMark. Видно кадры в секунду, ровность их следования, температуру, загрузку и потребляемую мощность. Картинка ничего не измеряет: карта греется от расчёта кадра, а не от вывода на экран."/>
                            <Button Content="Игровой замер (кадры)" Click="OnGpuGameTest"
                                    Style="{StaticResource TestBtn}"
                                    ToolTip="Видеокарта рисует кадры с тяжёлым шейдером — растеризация, текстуры, освещение, как в настоящей игре. Показывает кадры в секунду и ровность их следования (по ней видно рывки, которых не видно по среднему числу)."/>
                            <Button Content="Скорость для нейросетей" Click="OnGpuLlmTest"
                                    Style="{StaticResource TestBtn}"
                                    ToolTip="Умножение матриц на тензорных блоках через DirectML — та же операция, из которой состоит работа языковой модели. Плюс оценка, модель какого размера поместится и с какой скоростью пойдёт."/>

                            <TextBlock Text="СТАБИЛЬНОСТЬ" Style="{StaticResource TestGroup}"/>

                            <Button Content="🔥  Перейти к стресс-тесту" Click="OnGoToStressTab"
                                    Style="{StaticResource TestBtn}"
                                    ToolTip="Длительная нагрузка с живыми графиками живёт на отдельной вкладке — там видно, как меняются температура и скорость вычислений по ходу теста."/>

                            <Button Content="Отчёт о сбоях ПК" Click="OnCrashReport"
                                    Style="{StaticResource TestBtn}"
                                    ToolTip="Разбирает журналы Windows: синие экраны с расшифровкой кода, аппаратные ошибки, срывы видеодрайвера, ошибки дисков. Плюс собственный журнал состояния — что было с температурами перед сбоем. Компьютер не нагружается."/>

                            <Button Content="Журнал состояния" Click="OnBlackBoxInfo"
                                    Style="{StaticResource TestBtn}"
                                    ToolTip="Куда пишется посекундная запись состояния машины и как ей пользоваться после сбоя."/>

                            <TextBlock Text="СБРОС СЕТИ" Style="{StaticResource TestGroup}"/>

                            <ComboBox x:Name="ResetScopeCombo" SelectedIndex="0" Margin="0,0,0,4"
                                      SelectionChanged="OnResetScopeChanged"
                                      ToolTip="Насколько глубоко сбрасывать. Начинайте с верхнего — он безопасный.">
                                <ComboBoxItem Content="Кэши DNS, ARP, NetBIOS" Tag="0"/>
                                <ComboBoxItem Content="+ новый адрес у роутера" Tag="1"/>
                                <ComboBoxItem Content="+ перезапуск адаптера"  Tag="2"/>
                                <ComboBoxItem Content="+ сброс Winsock и TCP/IP" Tag="3"/>
                            </ComboBox>

                            <TextBlock x:Name="ResetScopeHint" TextWrapping="Wrap" FontSize="10"
                                       Foreground="#5C7A69" Margin="2,0,0,6"/>

                            <Button x:Name="ResetNetBtn" Content="⟳  Перезагрузить сеть"
                                    Click="OnNetworkReset" Style="{StaticResource TestBtnDanger}"
                                    ToolTip="Перезапускает сеть, не перезагружая Windows. Потребуются права администратора."/>

                            <TextBlock Text="ПАМЯТЬ" Style="{StaticResource TestGroup}"/>

                            <Button Content="Очистить кэш ОЗУ" Click="OnClearRamCache"
                                    Style="{StaticResource TestBtn}"
                                    ToolTip="Освобождает страницы памяти, которые Windows держит про запас (список ожидания). Работающие программы не трогает. Потребуются права администратора."/>

                            <TextBlock Text="ПРОЧЕЕ" Style="{StaticResource TestGroup}"/>

                            <Button Content="Счётчик FPS: состояние" Click="OnFpsStatus"
                                    Style="{StaticResource TestBtn}"
                                    ToolTip="Почему в оверлее показывается число кадров или прочерк, и что нужно, чтобы заработало."/>
                            <Button Content="Проверить обновление" Click="OnCheckUpdate"
                                    Style="{StaticResource TestBtn}"
                                    ToolTip="Спросить сервер обновлений, есть ли версия новее установленной."/>
                            <Button Content="Ярлык на рабочем столе" Click="OnCreateShortcutFromTests"
                                    Style="{StaticResource TestBtn}"
                                    ToolTip="Создать ярлык NetAudit на рабочем столе."/>
                            <Button Content="Ярлык (администратор)" Click="OnCreateElevatedShortcut"
                                    Style="{StaticResource TestBtn}"
                                    ToolTip="Отдельный ярлык, который всегда запускает NetAudit с правами администратора — Windows спросит подтверждение (UAC) при каждом запуске. Нужен для счётчика FPS: без прав он выключен, а права не сохраняются между запусками программы."/>
                            <Button Content="Папка с данными" Click="OnOpenDataFolder"
                                    Style="{StaticResource TestBtn}"
                                    ToolTip="Открыть папку с настройками, логами пинга и журналом сбоев."/>
                        </StackPanel>
                    </ScrollViewer>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                                  Background="#23402F" Cursor="SizeWE"
                                  ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                                  ToolTip="Потяните, чтобы изменить ширину колонки с кнопками."/>

                    <!-- ── Правая колонка: вывод ── -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#0C1611" BorderBrush="#23402F"
                                BorderThickness="0,0,0,1" Padding="6,4">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" x:Name="TestStatusLbl"
                                           Style="{StaticResource Lbl}" Text="Тест не запущен"
                                           VerticalAlignment="Center"/>

                                <Button DockPanel.Dock="Right" Content="💾 Сохранить" Click="OnTestSave"
                                        Padding="8,2" Margin="4,0,0,0"
                                        ToolTip="Сохранить весь вывод в текстовый файл."/>
                                <Button DockPanel.Dock="Right" Content="📋 Копировать" Click="OnTestCopy"
                                        Padding="8,2" Margin="4,0,0,0"
                                        ToolTip="Скопировать весь вывод в буфер обмена."/>
                                <Button DockPanel.Dock="Right" Content="🗑 Очистить" Click="OnTestClear"
                                        Padding="8,2" Margin="4,0,0,0"
                                        ToolTip="Очистить вывод."/>
                                <Button DockPanel.Dock="Right" x:Name="TestStopBtn" Content="■ Остановить"
                                        Click="OnTestStop" IsEnabled="False" Padding="8,2"
                                        ToolTip="Прервать выполняющийся тест."/>
                            </DockPanel>
                        </Border>

                        <ListBox Grid.Row="1" x:Name="TestOutput"
                                 Background="#111F18" BorderThickness="0"
                                 FontFamily="Cascadia Code, Consolas, monospace" FontSize="11"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 ToolTip="Вывод теста. Строки накапливаются, пока их не очистить.">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Color}"
                                               FontWeight="{Binding Weight}"
                                               FontFamily="Cascadia Code, Consolas, monospace"
                                               FontSize="11" TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Вкладка 4: Стресс-тест -->
            <TabItem Header="🔥 Стресс-тест" x:Name="StressTab"
                     ToolTip="Длительная полная нагрузка с проверкой, что железо считает верно. Живые графики температур, загрузки и скорости вычислений.">
                <Grid Background="#111F18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="StressCtlCol" Width="238" MinWidth="200"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── Левая колонка: управление ── -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                  Background="#0C1611" Padding="8,4,8,8">
                        <StackPanel>

                            <TextBlock Text="ЧТО НАГРУЖАТЬ" Style="{StaticResource TestGroup}"/>

                            <CheckBox x:Name="StCpuChk" Content="Процессор" IsChecked="True"
                                      Margin="2,0,0,3" FontSize="11"
                                      ToolTip="Все ядра под полной нагрузкой. Каждый блок вычислений сверяется с заранее известным правильным ответом: исправный процессор не ошибается ни разу."/>
                            <CheckBox x:Name="StMemChk" Content="Оперативная память" IsChecked="True"
                                      Margin="2,0,0,3" FontSize="11"
                                      ToolTip="Заполнение памяти проверочными шаблонами и сверка обратно. Ловит битые ячейки и слишком агрессивный профиль XMP/DOCP."/>
                            <CheckBox x:Name="StGpuChk" Content="Видеокарта" IsChecked="False"
                                      Margin="2,0,0,3" FontSize="11"
                                      ToolTip="Свой вычислительный шейдер Direct3D 11: цепочки FMA плюс работа с видеопамятью — по смыслу то же, что делает FurMark. Никаких перехватов и внедрения в чужие процессы. Самая горячая часть теста."/>
                            <CheckBox x:Name="StDiskChk" Content="Накопитель" IsChecked="False"
                                      Margin="2,0,0,6" FontSize="11"
                                      ToolTip="Запись и перечитывание со сверкой. Выключено по умолчанию: длительная запись расходует ресурс SSD."/>

                            <TextBlock Text="ДЛИТЕЛЬНОСТЬ" Style="{StaticResource TestGroup}"/>

                            <ComboBox x:Name="StDurationCombo" SelectedIndex="1" Margin="0,0,0,6"
                                      ToolTip="Часть неисправностей проявляется только через 20–30 минут прогрева, поэтому короткий прогон ничего не доказывает.">
                                <ComboBoxItem Content="5 минут — грубая проверка" Tag="5"/>
                                <ComboBoxItem Content="15 минут — обычная"        Tag="15"/>
                                <ComboBoxItem Content="30 минут"                  Tag="30"/>
                                <ComboBoxItem Content="1 час — для б/у машины"    Tag="60"/>
                                <ComboBoxItem Content="3 часа — максимально"      Tag="180"/>
                            </ComboBox>

                            <Button x:Name="StStartBtn" Content="▶  Запустить" Click="OnStressStart"
                                    Style="{StaticResource TestBtnPrimary}"
                                    ToolTip="Начать нагрузку. Компьютер нагреется, вентиляторы выйдут на максимум — это и есть смысл теста."/>
                            <Button x:Name="StStopBtn" Content="■  Остановить" Click="OnStressStop"
                                    IsEnabled="False" Style="{StaticResource TestBtnDanger}"
                                    ToolTip="Прервать тест немедленно."/>

                            <TextBlock Text="ХОД ТЕСТА" Style="{StaticResource TestGroup}"/>

                            <ProgressBar x:Name="StProgress" Height="6" Minimum="0" Maximum="1" Value="0"
                                         Margin="0,0,0,5" Background="#152A20" Foreground="#4FD98B"
                                         BorderBrush="#23402F" BorderThickness="1"/>

                            <Grid Margin="2,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Прошло" Style="{StaticResource Lbl}"/>
                                <TextBlock Grid.Column="1" x:Name="StElapsedLbl" Text="—"
                                           Style="{StaticResource MiniVal}"/>
                            </Grid>
                            <Grid Margin="2,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Осталось" Style="{StaticResource Lbl}"/>
                                <TextBlock Grid.Column="1" x:Name="StRemainLbl" Text="—"
                                           Style="{StaticResource MiniVal}"/>
                            </Grid>
                            <Grid Margin="2,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Состояние" Style="{StaticResource Lbl}"/>
                                <TextBlock Grid.Column="1" x:Name="StStateLbl" Text="не запущен"
                                           Style="{StaticResource MiniVal}"/>
                            </Grid>

                            <TextBlock Text="МАКСИМУМЫ" Style="{StaticResource TestGroup}"/>

                            <Grid Margin="2,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Темп. CPU" Style="{StaticResource Lbl}"/>
                                <TextBlock Grid.Column="1" x:Name="StMaxCpuTempLbl" Text="—"
                                           Style="{StaticResource MiniVal}"/>
                            </Grid>
                            <Grid Margin="2,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Темп. GPU" Style="{StaticResource Lbl}"/>
                                <TextBlock Grid.Column="1" x:Name="StMaxGpuTempLbl" Text="—"
                                           Style="{StaticResource MiniVal}"/>
                            </Grid>
                            <Grid Margin="2,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Проверено ОЗУ" Style="{StaticResource Lbl}"/>
                                <TextBlock Grid.Column="1" x:Name="StMemCheckedLbl" Text="—"
                                           Style="{StaticResource MiniVal}"/>
                            </Grid>

                            <TextBlock x:Name="StHintLbl" TextWrapping="Wrap" FontSize="10"
                                       Foreground="#5C7A69" Margin="2,4,0,0"
                                       Text="Тест остановится сам при 95 °C. Температуры читаются только с правами администратора."/>

                            <Button Content="💾 Сохранить отчёт" Click="OnStressSave"
                                    Style="{StaticResource TestBtn}" Margin="0,8,0,0"
                                    ToolTip="Сохранить весь вывод теста в текстовый файл."/>
                        </StackPanel>
                    </ScrollViewer>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                                  Background="#23402F" Cursor="SizeWE"
                                  ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                                  ToolTip="Потяните, чтобы изменить ширину панели управления."/>

                    <!-- ── Правая колонка: плитки, графики, лог ── -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*" MinHeight="150"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="60"/>
                        </Grid.RowDefinitions>

                        <UniformGrid Grid.Row="0" Rows="1" Columns="6" Margin="4,4,4,2">
                            <Border Style="{StaticResource Card}" Margin="2" Padding="6,3">
                                <StackPanel>
                                    <TextBlock Text="Загрузка CPU" Style="{StaticResource Lbl}"/>
                                    <TextBlock x:Name="StCpuVal" Text="—" Style="{StaticResource Val}"
                                               Foreground="#E3B44F"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="2" Padding="6,3">
                                <StackPanel>
                                    <TextBlock Text="Темп. CPU" Style="{StaticResource Lbl}"/>
                                    <TextBlock x:Name="StCpuTempVal" Text="—" Style="{StaticResource Val}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="2" Padding="6,3">
                                <StackPanel>
                                    <TextBlock Text="Загрузка GPU" Style="{StaticResource Lbl}"/>
                                    <TextBlock x:Name="StGpuVal" Text="—" Style="{StaticResource Val}"
                                               Foreground="#5CD1C0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="2" Padding="6,3">
                                <StackPanel>
                                    <TextBlock Text="Темп. GPU" Style="{StaticResource Lbl}"/>
                                    <TextBlock x:Name="StGpuTempVal" Text="—" Style="{StaticResource Val}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="2" Padding="6,3">
                                <StackPanel>
                                    <TextBlock Text="Скорость CPU" Style="{StaticResource Lbl}"
                                               ToolTip="Миллионов операций в секунду. Падение по ходу теста — это троттлинг."/>
                                    <TextBlock x:Name="StSpeedVal" Text="—" Style="{StaticResource Val}"
                                               Foreground="#D4E8A8"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="2" Padding="6,3">
                                <StackPanel>
                                    <TextBlock Text="Ошибок" Style="{StaticResource Lbl}"
                                               ToolTip="Сколько раз железо посчитало неверно. Исправная машина не ошибается ни разу."/>
                                    <TextBlock x:Name="StErrVal" Text="0" Style="{StaticResource Val}"
                                               Foreground="#86D97A"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Grid.Row="1" Margin="4,2,4,2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Text="Температура" Foreground="#EE8B8B"
                                               Style="{StaticResource SecHdr}"/>
                                    <TextBlock Text="  CPU" Foreground="#E3B44F" FontSize="10"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="  GPU" Foreground="#5CD1C0" FontSize="10"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StTempHint" Text="  — нужны права администратора"
                                               Foreground="#5C7A69" FontSize="10" VerticalAlignment="Center"/>
                                </StackPanel>
                                <sp:WpfPlot Grid.Row="1" x:Name="PlotStressTemp"
                                            ToolTipService.IsEnabled="False"/>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Text="Загрузка, %" Foreground="#4FD98B"
                                               Style="{StaticResource SecHdr}"/>
                                    <TextBlock Text="  CPU" Foreground="#E3B44F" FontSize="10"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="  GPU" Foreground="#5CD1C0" FontSize="10"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <sp:WpfPlot Grid.Row="1" x:Name="PlotStressLoad"
                                            ToolTipService.IsEnabled="False"/>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Text="Скорость вычислений" Foreground="#D4E8A8"
                                               Style="{StaticResource SecHdr}"
                                               ToolTip="Проседание линии под нагрузкой — это троттлинг: перегрев или упор в лимит питания."/>
                                    <TextBlock Text="  CPU, млн оп/с" Foreground="#D4E8A8" FontSize="10"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="  GPU, млрд оп/с" Foreground="#86D97A" FontSize="10"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <sp:WpfPlot Grid.Row="1" x:Name="PlotStressSpeed"
                                            ToolTipService.IsEnabled="False"/>
                            </Grid>
                        </Grid>

                        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                                      Background="#23402F" Cursor="SizeNS"
                                      ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"
                                      ToolTip="Потяните, чтобы изменить высоту вывода."/>

                        <ListBox Grid.Row="3" x:Name="StressOutput"
                                 Background="#111F18" BorderThickness="0"
                                 FontFamily="Cascadia Code, Consolas, monospace" FontSize="11"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 ToolTip="Подробный ход теста и итоговый отчёт.">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Color}"
                                               FontWeight="{Binding Weight}"
                                               FontFamily="Cascadia Code, Consolas, monospace"
                                               FontSize="11" TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Вкладка 5: Лог -->
            <TabItem Header="📋 Лог событий" x:Name="LogTab"
                     ToolTip="Хронологический журнал пингов и событий. Последние 300 строк.">
                <Grid x:Name="LogPanel" Background="#111F18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Панель инструментов лога -->
                    <Border Grid.Row="0" Background="#0C1611" BorderBrush="#23402F"
                            BorderThickness="0,0,0,1" Padding="6,4">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="Фильтр:" Style="{StaticResource Lbl}"
                                       Margin="0,0,4,0"/>
                            <ComboBox DockPanel.Dock="Left" x:Name="LogFilterCombo" Width="130"
                                      FontSize="11" Background="#23402F" Foreground="#D8EADF"
                                      BorderBrush="#2C5039" SelectedIndex="0"
                                      SelectionChanged="OnLogFilterChanged"
                                      ToolTip="Какие строки показывать.">
                                <ComboBoxItem Content="Все"           Tag="all"/>
                                <ComboBoxItem Content="Только потери" Tag="timeout"/>
                                <ComboBoxItem Content="Только спайки" Tag="spike"/>
                                <ComboBoxItem Content="Потери+спайки" Tag="problems"/>
                                <ComboBoxItem Content="События"       Tag="event"/>
                                <ComboBoxItem Content="Шлюз"          Tag="gw"/>
                                <ComboBoxItem Content="Интернет"      Tag="cf"/>
                            </ComboBox>

                            <TextBlock DockPanel.Dock="Left" Text="Поиск:" Style="{StaticResource Lbl}"
                                       Margin="12,0,4,0"/>
                            <TextBox DockPanel.Dock="Left" x:Name="LogSearchBox" Width="140"
                                     FontSize="11" Background="#23402F" Foreground="#D8EADF"
                                     BorderBrush="#2C5039" Padding="4,2"
                                     TextChanged="OnLogSearchChanged"
                                     ToolTip="Показывать только строки, содержащие этот текст."/>

                            <TextBlock DockPanel.Dock="Left" x:Name="LogCountLbl"
                                       Style="{StaticResource Lbl}" Margin="12,0,0,0" Text="0 строк"
                                       ToolTip="Показано строк из общего числа в буфере (буфер — последние 2000)."/>

                            <Button DockPanel.Dock="Right" Content="💾 Сохранить" Click="OnLogSave"
                                    Background="#23402F" Foreground="#D8EADF" BorderBrush="#2C5039"
                                    Padding="8,2" FontSize="11" Cursor="Hand" Margin="4,0,0,0"
                                    ToolTip="Сохранить показанные строки в текстовый файл."/>
                            <Button DockPanel.Dock="Right" Content="🗑 Очистить" Click="OnLogClear"
                                    Background="#23402F" Foreground="#D8EADF" BorderBrush="#2C5039"
                                    Padding="8,2" FontSize="11" Cursor="Hand" Margin="4,0,0,0"
                                    ToolTip="Очистить буфер лога. На запись в файл на диске не влияет."/>
                            <Button DockPanel.Dock="Right" x:Name="LogPauseBtn"
                                    Content="⏸ Автопрокрутка" Click="OnLogPauseToggle"
                                    Background="#23402F" Foreground="#D8EADF" BorderBrush="#2C5039"
                                    Padding="8,2" FontSize="11" Cursor="Hand"
                                    ToolTip="Прокручивать список к новым строкам. Отключите, чтобы спокойно читать историю."/>
                        </DockPanel>
                    </Border>

                    <ListBox Grid.Row="1" x:Name="LogList"
                             Background="#111F18" BorderThickness="0"
                             FontFamily="Cascadia Code, Consolas, monospace" FontSize="11"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             ToolTip="Шлюз / Cloudflare · TIMEOUT = нет ответа · SPIKE = аномальная задержка.">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Color}"
                                           FontFamily="Cascadia Code, Consolas, monospace" FontSize="11"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2,0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <TextBlock Grid.Row="2" x:Name="LogDisabledMsg"
                               Text="Лог отключён в настройках."
                               Foreground="#2C5039" FontSize="11" Margin="6,4"
                               Visibility="Collapsed"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
