# ── Сборка .NET ───────────────────────────────────────────────────────────
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
*.userosscache
*.sln.docstates

# Результаты publish и релизные архивы: собираются из исходников,
# в репозитории им не место. В GitHub Releases они попадают отдельно
dist/
publish/
*.zip

# ── Сертификаты и ключи ───────────────────────────────────────────────────
# Никогда не коммитить: даже самоподписанный сертификат с закрытым ключом
# позволяет подписать что угодно вашим именем
*.pfx
*.snk
*.p12
NetAudit-cert.cer

# ── Среды разработки ──────────────────────────────────────────────────────
.vs/
.vscode/
.idea/
*.swp
*~

# ── Временное ─────────────────────────────────────────────────────────────
*.log
*.tmp
TestResults/

# ── Локальные настройки агента ────────────────────────────────────────────
# Общие правила проекта (.claude/rules.md, stack.md, skeleton.md, tasks.md)
# наоборот версионируются: без них новый агент начинает с нуля
# Со звёздочками: путь с косой чертой git привязывает к папке самого .gitignore,
# а такой файл есть и в app_lan/.claude, и в NetAudit/.claude
**/.claude/settings.local.json
